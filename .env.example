# Miniflux instance root URL, used when the backfill command omits --miniflux-url.
MINIFLUX_URL="http://localhost:8080"

# Miniflux API token used by the backfill command.
MINIFLUX_API_TOKEN="your-miniflux-api-token"

# Paid Afdian account Cookie header value. Used by: backfill --source afdian
AFDIAN_COOKIE="your-afdian-cookie"

# Zhihu account Cookie header value; must contain d_c0.
# Used by: backfill --source zhihu
ZHIHU_COOKIE="your-zhihu-cookie"
